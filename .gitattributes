# Normalize line endings across platforms
* text=auto

# Force LF for common text files
*.sln text eol=lf
*.slnx text eol=lf
*.cs text eol=lf
*.csproj text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
